# ── Data (patient/project-specific; generated by prepare_titan_inputs.R) ───────
app/data/*
!app/data/.gitkeep
!app/data/gencode_orfs_phase2.csv

# ── Scripts (keep only prepare_*.R) ────────────────────────────────────────────
scripts/*
!scripts/prepare_*.R

# ── R session artefacts ─────────────────────────────────────────────────────────
.Rhistory
.RData
.Rproj.user/
*.Rproj

# ── OS artefacts ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs / temp ─────────────────────────────────────────────────────────────────
*.log
slurm-*.out
