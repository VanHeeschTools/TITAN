# ── Data (patient/project-specific; generated by prepare_titan_inputs.R) ───────
app/data/*
!app/data/.gitkeep

# ── local-data/ — local auth SQLite DB (simulates the Cloud Run gcsfuse mount) ──
local-data/

# ── Scripts ─────────────────────────────────────────────────────────────────────
scripts/*
!scripts/prepare_*.R
!scripts/catalog_prep/
!scripts/catalog_prep/register_study.R
!scripts/catalog_prep/configs/
scripts/catalog_prep/configs/*.yaml
!scripts/reference_prep/
!scripts/reference_prep/*.R


# ── Profiling ─────────────────────────────────────────────────────────────────────
profiling/*

# ── Design (design inspiration) ────────────────────────────────────────────
design/*

# ── R session artefacts ─────────────────────────────────────────────────────────
.Rhistory
.RData
.Rproj.user/
*.Rproj

# ── OS artefacts ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs / temp ─────────────────────────────────────────────────────────────────
*.log
slurm-*.out

# ── Backups ─────────────────────────────────────────────────────────────────
app/*.bak*
app/R/*.bak*

# ── bin/ — BLAST binaries (large compiled executables; fetched at build time) ──
app/bin/blastp
app/bin/blastdbcmd
app/bin/blastp.REAL
app/bin/ncbi-blast-2.14.0+-x64-linux.tar.gz
app/bin/ncbi-blast-2.14.0+/

# ── ref/ — derived runtime artefacts (RDS, BLAST db, large CSVs) ─────────────
app/ref/**/*.rds
app/ref/**/*.RDS
app/ref/**/*.csv
app/ref/**/*.pdb
app/ref/**/*.phr
app/ref/**/*.pin
app/ref/**/*.pjs
app/ref/**/*.pot
app/ref/**/*.psq

# ── ref/ — obsolete references ───────────────────────────────────────────────
app/ref/swissprot_human/
app/ref/ncbi_blast-2.14.0.sif

# ── ref/ — raw source downloads (intermediate files, not read by app) ─────────
app/ref/ensembl114_pep/Homo_sapiens.GRCh38.pep.all.fa
app/ref/ensembl114_pep/Homo_sapiens.GRCh38.pep.all.fa.gz
app/ref/ensembl114_pep/ensembl114_pep_dedup.fa
app/ref/allergen_uniprot/allergen_uniprot.fasta
